# Copy to `.env` in the same directory and fill in. `.env` is gitignored.

GEMINI_API_KEY=
# Optional override (default in code is gemini-2.5-flash):
# GEMINI_MODEL=gemini-2.5-flash
# Fail the run on Gemini errors instead of falling back to template (429/503):
# GEMINI_STRICT=1
# Days to extend API fetch before the CLI start date (multi-game series; default 21):
# GUARDIANS_UMPS_FETCH_LOOKBACK_DAYS=21
